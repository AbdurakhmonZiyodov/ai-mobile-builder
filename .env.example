# --- Ma'lumotlar bazasi ---
DATABASE_URL=postgres://localhost:5432/amb

# --- Model qatlami ---
# Kalit bo'lmasa tizim `mock` provayderda ishlaydi: butun tsikl (tasniflash,
# tool chaqirish, verify gate, o'zgarish hisobi) kalitsiz sinaladi.
AI_GATEWAY_API_KEY=
# yoki to'g'ridan-to'g'ri:
ANTHROPIC_API_KEY=

# Provayderni majburlash: gateway | mock
AMB_MODEL_PROVIDER=

# Tier -> model. Model drifti bo'lganda faqat shu qatorlar o'zgaradi.
AMB_MODEL_CHEAP=anthropic/claude-haiku-4.5
AMB_MODEL_STANDARD=anthropic/claude-sonnet-5
AMB_MODEL_STRONG=anthropic/claude-opus-5

# --- Workspace ---
AMB_WORKSPACE_ROOT=
AMB_TEMPLATE_DIR=

# --- Sirlar ---
# Mijoz kalitlarini shifrlash uchun. Ishlab chiqarishda KMS.
AMB_SECRET_KEY=

# --- Manzillar ---
PORT=4000
AMB_WEB_ORIGIN=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:4000
