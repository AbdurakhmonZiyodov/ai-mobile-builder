# ─── Ma'lumotlar bazasi ────────────────────────────────────────────────
DATABASE_URL=postgres://localhost:5432/amb

# ─── Model (Vercel AI Gateway) ─────────────────────────────────────────
# Bittasi MAJBURIY. Kalitsiz server ishga tushmaydi — soxta (mock) model
# ataylab qo'yilmagan: u mijozga ilovasi ishlayotgandek ko'rsatadi.
#
#   Kalit olish:  https://vercel.com/docs/ai-gateway/getting-started
#   yoki Vercel loyihasi bilan:  vercel link && vercel env pull
AI_GATEWAY_API_KEY=
# VERCEL_OIDC_TOKEN=   (Vercel'da avtomatik beriladi)

# Tier -> model. Model yangilansa yoki provayder o'zgarsa, faqat shular tegiladi.
# ID'lar: https://ai-gateway.vercel.sh/v1/models
AMB_MODEL_CHEAP=anthropic/claude-haiku-4.5
AMB_MODEL_STANDARD=anthropic/claude-sonnet-5
AMB_MODEL_STRONG=anthropic/claude-opus-5

# ─── Sirlar ────────────────────────────────────────────────────────────
# Mijoz kalitlarini shifrlash (AES-256-GCM). Kamida 32 belgi.
# Yasash:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Ishlab chiqarishda KMS — kalit diskka umuman tushmasligi kerak.
AMB_SECRET_KEY=

# ─── Workspace ─────────────────────────────────────────────────────────
# Bo'sh qoldirilsa: <repo>/workspaces va <repo>/templates/mobile
AMB_WORKSPACE_ROOT=
AMB_TEMPLATE_DIR=

# ─── Manzillar ─────────────────────────────────────────────────────────
PORT=4000
AMB_WEB_ORIGIN=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:4000
