{
  "name": "@amb/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/server.js",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node --env-file-if-exists=../../.env dist/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "clean": "rm -rf dist .turbo *.tsbuildinfo"
  },
  "dependencies": {
    "@amb/shared": "*",
    "@amb/db": "*",
    "@amb/agent": "*",
    "@amb/ai": "*",
    "@amb/blocks": "*",
    "@amb/domains": "*",
    "@amb/workspace": "*",
    "@amb/verify": "*",
    "@amb/review-checker": "*",
    "@hono/node-server": "^1.15.0",
    "hono": "^4.13.7",
    "drizzle-orm": "^0.45.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "tsx": "^4.20.1",
    "typescript": "^5.9.3",
    "@types/node": "^22.15.3"
  }
}
