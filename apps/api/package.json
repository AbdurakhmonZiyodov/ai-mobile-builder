{
  "name": "@amb/api",
  "version": "0.1.0",
  "description": "AI mobil ilova builder — orkestrator backend (NestJS)",
  "private": true,
  "scripts": {
    "dev": "concurrently -n tsc,node -c blue,green \"tsc -p tsconfig.json --watch --preserveWatchOutput\" \"node --watch --enable-source-maps dist/main.js\"",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint \"src/**/*.ts\" --max-warnings 0",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "clean": "rm -rf dist .turbo *.tsbuildinfo"
  },
  "dependencies": {
    "@amb/blocks": "*",
    "@amb/contracts": "*",
    "@amb/core-rules": "*",
    "@amb/domains": "*",
    "@nestjs/common": "^12.0.2",
    "@nestjs/config": "^12.0.0",
    "@nestjs/core": "^12.0.2",
    "@nestjs/platform-express": "^12.0.2",
    "ai": "^7.0.99",
    "drizzle-orm": "^0.45.2",
    "postgres": "^3.4.7",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^22.15.3",
    "drizzle-kit": "^0.31.10",
    "typescript": "^7.0.2",
    "vitest": "^3.2.4",
    "concurrently": "^9.1.2"
  }
}
